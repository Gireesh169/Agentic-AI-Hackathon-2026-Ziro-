# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Supabase (optional for local development)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-server-side-secret
# Newer key name accepted when it contains a server-side secret:
SUPABASE_SECRET_KEY=replace-with-your-supabase-server-side-secret

# App
# Use comma-separated origins when both local and deployed frontends are needed.
FRONTEND_ORIGINS=http://why liek:5173
